<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <OpenSSHDependencyInclude>$(MSBuildThisFileDirectory)vcpkg_installed/x64-custom/x64-custom/include</OpenSSHDependencyInclude>
  </PropertyGroup>

  <Target
    Name="AddOpenSSHDependencyHeaders"
    BeforeTargets="ClCompile"
    Condition="'$(Platform)' == 'x64'">

    <Error
      Condition="!Exists('$(OpenSSHDependencyInclude)/openssl/opensslv.h')"
      Text="LibreSSL header missing before compilation: $(OpenSSHDependencyInclude)/openssl/opensslv.h" />

    <ItemGroup>
      <ClCompile Update="@(ClCompile)">
        <AdditionalIncludeDirectories>$(OpenSSHDependencyInclude);%(ClCompile.AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      </ClCompile>
    </ItemGroup>

    <Message
      Importance="High"
      Text="Dependency headers for $(MSBuildProjectName): $(OpenSSHDependencyInclude)" />

  </Target>

</Project>
